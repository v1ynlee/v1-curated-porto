# Production environment — committed to repo.
# Next.js reads this file automatically when NODE_ENV=production (i.e. on Vercel).
# Variables set in the Vercel dashboard override values in this file.
# Do NOT store secrets here; NEXT_PUBLIC_* variables are embedded into the client bundle.

NEXT_PUBLIC_SITE_URL=https://curated-comics.cyou
NEXT_PUBLIC_CDN_URL=https://cdn.curated-comics.cyou
