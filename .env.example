# Local development environment
# Copy this file to .env.local and adjust values as needed.
# .env.local is gitignored and never committed.

# Site canonical URL (used for OG tags, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CDN base URL — leave empty to serve assets from local /public directory.
# Set this to https://cdn.curated-comics.cyou when testing R2 locally.
NEXT_PUBLIC_CDN_URL=
