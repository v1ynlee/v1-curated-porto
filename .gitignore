# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ───────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ───────────────────────────────────────────────────────
/.next/
/out/
/build

# ── Environment files ──────────────────────────────────────────────────────────
# Commit .env.example (template) and .env.production (documents required vars).
# Never commit .env.local or any file containing real secrets.
.env*
!.env.example
!.env.production

# ── Vercel ─────────────────────────────────────────────────────────────────────
.vercel

# ── TypeScript ─────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── OS / editor noise ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── Debug / log files ─────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Test coverage ─────────────────────────────────────────────────────────────
/coverage

# ── Local scratch / work-in-progress ──────────────────────────────────────────
trash/
scripts/

# ── Unused Next.js scaffold placeholders ──────────────────────────────────────
public/file.svg
public/globe.svg
public/next.svg
public/vercel.svg
public/window.svg

# ── Cloudflare R2 media (served via CDN in production) ────────────────────────
# Upload these to the R2 bucket instead of committing to git.
# Local copies remain in /public for development convenience.
/public/covers/
/public/characters/
/public/music/audio/
/public/music/covers/